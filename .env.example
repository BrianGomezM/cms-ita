# Variables usadas por docker-compose.yml para levantar la infraestructura
# local (PostgreSQL + MinIO). Copiar a ".env" y ajustar los valores.
#
# Uso habitual en desarrollo: solo se levantan postgres/minio con Docker
# (`pnpm db:up`), y el CMS/frontend corren en el host con `pnpm dev`, por eso
# S3_ENDPOINT y NEXT_PUBLIC_SERVER_URL apuntan a localhost. Si en algún
# momento levantas también los servicios "cms"/"web" del docker-compose
# (stack 100% containerizado), cambia S3_ENDPOINT a http://minio:9000 para
# que el contenedor del CMS pueda resolver el host "minio" de la red interna
# de Docker.

# PostgreSQL
POSTGRES_DB=cms_ita
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=cambia_esta_password_local

# MinIO (almacenamiento S3 compatible)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=cambia_esta_password_local

# Debe coincidir con lo que uses en apps/cms/.env
PAYLOAD_SECRET=genera_un_secreto_seguro_de_minimo_32_caracteres
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

S3_BUCKET=cms-media
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=cambia_esta_password_local
S3_REGION=us-east-1
