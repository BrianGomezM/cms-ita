# URL del CMS (API pública de Payload)
NEXT_PUBLIC_CMS_URL=http://localhost:3000

# URL pública de este sitio (usada para generar sitemap.xml, robots.txt y
# como referencia de "live preview" desde el CMS)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Tenant que se sirve cuando el host no coincide con ningún tenant
# registrado (dev local, o build-time sin contexto de request)
DEFAULT_TENANT_SLUG=camara-comercio-cauca

# Dominio base para resolver subdominios de tenant (tenant.cms.co)
NEXT_PUBLIC_BASE_DOMAIN=cms.co

# Debe coincidir EXACTO con REVALIDATE_SECRET de apps/cms/.env: el CMS llama
# a /api/revalidate de este sitio con este secreto para invalidar el caché
# cuando se publica/edita una página.
REVALIDATE_SECRET=genera_un_secreto_seguro

NODE_ENV=development
