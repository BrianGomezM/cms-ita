# Copiar a apps/web/.env.production en el SERVIDOR y rellenar (nunca commitear).

# El CMS y el sitio quedan en el mismo dominio (Nginx separa por ruta:
# /admin, /api, /graphql -> cms; el resto -> web), asi que ambas apuntan
# al mismo dominio publico.
NEXT_PUBLIC_CMS_URL=https://ccc.bodecom.com
NEXT_PUBLIC_SITE_URL=https://ccc.bodecom.com

# Tenant a servir cuando el host no coincide con ninguno registrado
DEFAULT_TENANT_SLUG=camara-comercio-cauca

# Dominio base para resolver subdominios de tenant
NEXT_PUBLIC_BASE_DOMAIN=bodecom.com

# Debe coincidir EXACTO con REVALIDATE_SECRET de apps/cms/.env.production
REVALIDATE_SECRET=genera_un_secreto_seguro
