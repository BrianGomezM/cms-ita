# Base de datos PostgreSQL
DATABASE_URI=postgresql://cms_user:TU_PASSWORD@127.0.0.1:5433/cms_ita

# Secreto de Payload (mínimo 32 caracteres)
PAYLOAD_SECRET=genera_un_secreto_seguro_de_minimo_32_caracteres

# URL pública del servidor
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Almacenamiento S3 / MinIO
S3_BUCKET=cms-media
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=TU_PASSWORD_MINIO
S3_REGION=us-east-1

NODE_ENV=development
# Revalidación bajo demanda (sitio web Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
REVALIDATE_SECRET=genera_un_secreto_seguro
