# Copiar a apps/cms/.env.production en el SERVIDOR y rellenar (nunca commitear).

# Postgres nativo del host (bodecom-central). El contenedor lo alcanza via
# host.docker.internal, que docker-compose.prod.yml mapea al host real.
DATABASE_URI=postgresql://USUARIO:PASSWORD@host.docker.internal:5432/cms_ita

# Minimo 32 caracteres. Generar uno nuevo para produccion, no reusar el de dev.
PAYLOAD_SECRET=genera_un_secreto_seguro_de_minimo_32_caracteres

# Dominio publico real (el admin y las cookies dependen de esto)
NEXT_PUBLIC_SERVER_URL=https://ccc.bodecom.com

# MinIO corre como contenedor "minio" en la misma red de docker compose
S3_BUCKET=cms-media
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=genera_una_password_segura_para_minio
S3_REGION=us-east-1

# Debe coincidir EXACTO con REVALIDATE_SECRET de apps/web/.env.production
REVALIDATE_SECRET=genera_un_secreto_seguro
